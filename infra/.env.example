# /opt/fgen/.env on the EC2 host. Never commit the real one.
# Values in <angle brackets> must be filled in.

# ---- deploy (IMAGE_TAG is rewritten by every deploy) ----
REGISTRY=ghcr.io/<github-owner>/<repo>
IMAGE_TAG=latest
DOMAIN=fgen.ca
ACME_EMAIL=info@fgen.ca

# ---- postgres ----
POSTGRES_DB=fgen
POSTGRES_USER=fgen
POSTGRES_PASSWORD=change-me

# ---- django ----
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=fgen.ca,www.fgen.ca,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://fgen.ca,https://www.fgen.ca
SITE_URL=https://www.fgen.ca

# ---- email (Office365) ----
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@fgen.ca
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=info@fgen.ca

# ---- stripe (names are historical; put the live keys here) ----
STRIPE_PUBLIC_KEY_TEST=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
PRODUCT_PRICE=price_1PhLSdFQ7fQ9eiOG4z1Rngtx
PRODUCT_ID=prod_QYSNWnTHKR94q7
