# Local development only: copy to `.env` (gitignored).
# Production values live in /opt/fgen/.env on the EC2 host -- see infra/.env.example.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Leave unset to use ./db.sqlite3
# DATABASE_URL=postgres://user:pass@localhost:5432/fgen

# Print emails to the console instead of sending them
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Stripe test-mode keys
STRIPE_PUBLIC_KEY_TEST=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
