# Copy this file to `.env` for local development (never commit the real .env).
# In production these are set as Heroku config vars instead - see DEPLOYMENT_GUIDE.md.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True

# Database (leave unset locally to use sqlite; Heroku sets DATABASE_URL automatically)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (Office365 SMTP)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@fgen.ca
EMAIL_HOST_PASSWORD=replace-with-real-app-password
DEFAULT_FROM_EMAIL=info@fgen.ca

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Stripe
STRIPE_PUBLIC_KEY_TEST=replace-me
STRIPE_SECRET_KEY_TEST=replace-me
STRIPE_WEBHOOK_SECRET_TEST=replace-me
PRODUCT_PRICE=replace-me
PRODUCT_ID=replace-me
REDIRECT_DOMAIN=https://www.fgen.ca
